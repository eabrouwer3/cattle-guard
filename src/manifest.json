{
  "manifest_version": 3,
  "name": "Cattle Guard",
  "version": "0.1.0",
  "description": "Blocks configured sites behind a full-page gate on every navigation, including single-page-app route changes, until you deliberately click through.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Cattle Guard settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["webNavigation", "storage", "scripting"],
  "host_permissions": ["*://*.youtube.com/*", "*://*.reddit.com/*"],
  "optional_host_permissions": ["*://*/*"]
}
